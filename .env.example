# =============================================================================
# CardioVision AI — Clinical Platform Configuration & Live SMTP Settings
# =============================================================================
# To send actual, real emails to original email addresses (physicians and patients),
# copy this file to '.env' in the project root and fill in your credentials below.
# If omitted or left empty, CardioVision operates in Local Simulation Mode,
# showing the 6-digit codes in the web UI and console for instant testing.
# =============================================================================

# Server settings
PORT=5000
HOST=0.0.0.0
SECRET_KEY=cardiovision-super-secret-clinical-key-2026

# --- Production SMTP Email Settings ---
# Example for Google Gmail (Use a 16-character Google App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-hospital-email@gmail.com
# SMTP_PASSWORD=your-google-app-password
# SMTP_FROM=CardioVision Security <noreply@cardiovision.org>

# Example for SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your-sendgrid-api-key
# SMTP_FROM=CardioVision Security <verify@yourdomain.com>

# Example for Amazon SES:
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your-ses-smtp-username
# SMTP_PASSWORD=your-ses-smtp-password
# SMTP_FROM=CardioVision Security <verify@yourdomain.com>
